{
  "seed": 42,
  "device": "cuda",
  "charset_path": "data/charset.txt",
  "text_path": "data/extracted_texts_cleaned.txt",
  "pairs_csv": "data/pairs_with_errors_combined.csv",
  "words_path": "data/all_words.txt",
  "max_words": 16,
  "ocr_window": 16,
  "p_real_start": 0.25,
  "p_real_end": 0.5,
  "noise_prob": 0.03,
  "p_ending_swap": 0.02,
  "p_extra_punct": 0.01,
  "p_hyphen_comma": 0.01,
  "p_comma_prefix": 0.01,
  "p_repeat_ending": 0.01,
  "p_single_hyphen": 0.02,
  "emb_size": 192,
  "n_layers": 6,
  "n_heads": 6,
  "ffn_size": 768,
  "dropout": 0.1,
  "epochs": 10,
  "batch_size": 256,
  "lr": 0.0003,
  "weight_decay": 0.0001,
  "grad_clip": 1.0,
  "eval_every_epochs": 1,
  "save_dir": "checkpoints2",
  "resume": null
}